# Build context exclusions.
#
# Everything here is sent to the Docker daemon on every build. The .git
# directory is usually the largest thing in the repo and is never needed to
# compile a Go binary — excluding it is the single biggest build speed-up.
.git
.gitignore
.github

# Local secrets and env files
.env
.env.*
*.local

# Compiled binaries (the real build happens inside the image)
flaggo
flaggo-web
flaggo-client
client

# Docs are not needed to build
*.md

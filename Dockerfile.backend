# Stage 1 - Build
FROM golang:1.27-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /app/binary ./cmd/flaggo

# Stage 2 - Runtime
FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /
COPY --from=builder /app/binary /binary
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/binary"]
